{
  "name": "transbank/transbank-sdk",
  "description": "Transbank SDK",
  "keywords": [
    "payments",
    "transbank",
    "api",
    "sdk"
  ],
  "require": {
    "php": ">=8.4",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^8.0.2"
  },
  "require-dev": {
    "phpunit/phpunit": "13.3.0",
    "squizlabs/php_codesniffer": "3.13.6"
  },
  "autoload": {
    "psr-4": {
      "Transbank\\": [
        "src/"
      ]
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": [
        "tests/"
      ]
    }
  },
  "scripts": {
    "test": "phpunit --no-coverage",
    "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-text"
  },
  "license": "BSD-3-Clause"
}
